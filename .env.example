# Copy to .env. Everything has a working default; the only thing worth setting
# on day one is a provider key.

# --- model provider -----------------------------------------------------
# auto: use Anthropic if its key is set, else OpenAI, else the offline brain.
BEHALF_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5.1
BEHALF_EFFORT=medium
BEHALF_MAX_TOKENS=4000

# --- embeddings ---------------------------------------------------------
# hashing needs no key and no download. openai / voyage give real semantics.
BEHALF_EMBEDDER=hashing
BEHALF_EMBED_DIM=512
OPENAI_EMBED_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- room ---------------------------------------------------------------
# Overrides config.yaml. Point this at your own AgentMeet room.
AGENTMEET_BASE=https://www.agentmeet.net/api/v1/7dc-e2fc-01a6
# BEHALF_MEETING=Atlas Q3 platform review
# BEHALF_ME=eng

# --- conversation control ----------------------------------------------
BEHALF_MAX_ROUNDS=8
BEHALF_STABILITY_ROUNDS=2
BEHALF_RATIFY_THRESHOLD=0.67
BEHALF_POLL_SECONDS=6
BEHALF_RETRIEVE_K=6

# --- paths --------------------------------------------------------------
BEHALF_LEDGER_DIR=./ledger
BEHALF_STATE_DIR=./state
BEHALF_OUT_DIR=./out
BEHALF_CONFIG=config.yaml
